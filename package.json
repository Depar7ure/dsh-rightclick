{
  "name": "dsh-rightclick",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "在 DSH Web GUI 的对话区空白处与侧边栏空白处右键，弹出上下文菜单（刷新 / 归档 / 撤销 / 重做 / 复制 / 粘贴 / 打开新对话 / 打开分支对话）。",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  }
}
